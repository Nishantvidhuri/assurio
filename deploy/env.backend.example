# ── Assurio backend — production. Copy to backend/.env on the server. ──
# dotenv reads this ONCE at boot: any change needs `sudo systemctl restart assurio-backend`.

NODE_ENV=production
PORT=3001

# ── URLs — every one of these must be the real domain. Getting these wrong is
#    the most common broken deploy: verification links, DigiLocker redirects
#    and WhatsApp invites all embed them. ──
APP_URL=https://your-domain.com
PUBLIC_APP_URL=https://your-domain.com
CLIENT_APP_URLS=https://your-domain.com
DIGILOCKER_REDIRECT_URL=https://your-domain.com/home

# ── Datastores (all loopback — see deploy/docker-compose.prod.yml) ──
DATABASE_URL=postgresql://assurio:REPLACE_WITH_DEPLOY_ENV_PASSWORD@localhost:5435/assurio
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ── Auth ──
# openssl rand -hex 32
JWT_SECRET=REPLACE_ME
COOKIE_SAMESITE_NONE=false

# ── Verification vendors ──
SUREPASS_BASE_URL=https://kyc-api.surepass.app
SUREPASS_API_TOKEN=
KONNECTNXT_BASE_URL=https://bgv.konnectnxt.com
KONNECTNXT_API_KEY=
KONNECTNXT_WEBHOOK_SECRET=

# ── Feature flags ──
PASSPORT_CHECK_ENABLED=true
CREDIT_CHECK_ENABLED=false

# ── WhatsApp (OpenWA — loopback only) ──
OPENWA_URL=http://127.0.0.1:2785/api
OPENWA_SESSION=assurio
OPENWA_API_KEY=
OPENWA_COUNTRY_CODE=91

# ── Storage (S3) ──
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Email ──
RESEND_API_KEY=
EMAIL_FROM=

# ── Payments ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# ── Google sign-in ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Chromium for report PDFs. Set only if it isn't on a standard path. ──
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium

# ── Ops ──
CONSENT_EXPIRY_DAYS=7
