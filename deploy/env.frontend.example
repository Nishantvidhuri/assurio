# ── Assurio frontend — copy to frontend/.env.local on the server. ──
# NEXT_PUBLIC_* is COMPILED INTO THE BUNDLE at build time.
# Set these BEFORE `npm run build` — a restart alone will not pick them up.
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_PASSPORT_CHECK_ENABLED=true
NEXT_PUBLIC_CREDIT_CHECK_ENABLED=false
