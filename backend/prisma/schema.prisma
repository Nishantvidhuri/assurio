generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String
  role                String    @default("owner")
  phone               String?
  resetToken          String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())

  subjects Subject[]
  invoices Invoice[]
}

model Subject {
  id                String    @id @default(cuid())
  userId            String
  name              String
  role              String    @default("")
  email             String    @default("")
  phone             String    @default("")
  inviteToken       String?
  status            String    @default("invited")
  passwordHash      String?
  panFront          String?
  panBack           String?
  panNumber         String?
  aadhaarFront      String?
  aadhaarBack       String?
  aadhaarNumber     String?
  panResult         Json?
  aadhaarResult     Json?
  digilockerClientId String?
  digilockerUrl     String?
  crimeRequestId    String?
  crimeResult       Json?
  consentResult     Json?
  verificationLog   Json      @default("[]")
  resetToken        String?
  resetTokenExpiresAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  invoices Invoice[]

  @@index([userId])
}

model Invoice {
  id                             String    @id @default(cuid())
  invoiceNumber                  String    @unique
  userId                         String
  subjectId                      String?
  customerName                   String
  customerEmail                  String
  customerPhone                  String?
  lineItems                      Json      @default("[]")
  subtotal                       Float
  tax                            Float
  total                          Float
  taxRatePercent                 Float     @default(18)
  currency                       String    @default("INR")
  status                         String    @default("paid")
  razorpayPaymentId              String    @unique
  razorpayPaymentLinkId          String?
  razorpayPaymentLinkReferenceId String?
  paidAt                         DateTime?
  pdfS3Key                       String?
  notes                          Json?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@index([userId])
  @@index([customerEmail])
}

model BulkBatch {
  id         String      @id @default(cuid())
  batchId    String      @unique
  userId     String
  total      Int
  done       Int         @default(0)
  failed     Int         @default(0)
  status     String      @default("processing")
  failedRows Json        @default("[]")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
}

model SubjectDraft {
  id        String   @id @default(cuid())
  subjectId String   @unique
  patch     Json
  jobId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OutboxEvent {
  id              String    @id @default(cuid())
  eventType       String
  payload         Json
  status          String    @default("pending")
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5)
  processAfter    DateTime  @default(now())
  processedAt     DateTime?
  lastError       String?
  idempotencyKey  String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([processAfter])
}
