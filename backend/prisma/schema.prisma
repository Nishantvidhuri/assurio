generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String
  role                String    @default("owner")
  phone               String?
  resetToken          String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())

  // Client billing (ported from Recriauth): PREPAID clients buy credits up
  // front; POSTPAID clients are billed monthly (Net 30). creditsBalance is the
  // client wallet — topped up when a PAYMENT_DUE invoice is marked paid, spent
  // as checks run. ₹1 = 1 credit.
  clientBillingModel  String    @default("PREPAID")
  creditsBalance      Float     @default(0)

  subjects Subject[]
  invoices Invoice[]
}

model Subject {
  id                String    @id @default(cuid())
  userId            String
  name              String
  role              String    @default("")
  email             String    @default("")
  phone             String    @default("")
  inviteToken       String?
  status            String    @default("invited")
  passwordHash      String?
  panFront          String?
  panBack           String?
  panNumber         String?
  aadhaarFront      String?
  aadhaarBack       String?
  aadhaarNumber     String?
  // Extra details captured from the form — needed to auto-run the checks.
  dob               String?
  fatherName        String?
  permanentAddress  String?
  pincode           String?
  drivingLicense    String?
  voterId           String?
  passportFileNo    String?
  uan               String?
  panResult         Json?
  aadhaarResult     Json?
  voterResult       Json?
  passportResult    Json?
  dlResult          Json?
  employmentResult  Json?
  digilockerClientId String?
  digilockerUrl     String?
  crimeRequestId    String?
  creditRequestId   String?
  creditResult      Json?
  crimeResult       Json?
  consentResult     Json?
  consentAcceptedAt DateTime?
  verificationLog   Json      @default("[]")
  resetToken        String?
  resetTokenExpiresAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  invoices Invoice[]

  @@index([userId])
}

model Invoice {
  id                             String    @id @default(cuid())
  invoiceNumber                  String    @unique
  userId                         String
  subjectId                      String?
  customerName                   String
  customerEmail                  String
  customerPhone                  String?
  lineItems                      Json      @default("[]")
  subtotal                       Float
  tax                            Float
  total                          Float
  taxRatePercent                 Float     @default(18)
  currency                       String    @default("INR")
  status                         String    @default("paid")

  // ── Invoice lifecycle (ported from Recriauth) ──
  // kind: INSTANT_PAID = the Razorpay one-shot receipt; PAYMENT_DUE = an
  // operator-raised invoice the client pays out of band; POSTPAID = an
  // auto-generated monthly bill. businessStatus tracks DUE → PAID / VOID.
  kind                           InvoiceKind           @default(INSTANT_PAID)
  businessStatus                 InvoiceBusinessStatus @default(PAID)
  paymentMethod                  InvoicePaymentMethod?
  paymentTerms                   InvoicePaymentTerms?
  credits                        Float?                // prepaid: credits billed
  dueAt                          DateTime?
  markedPaidAt                   DateTime?
  voidedAt                       DateTime?
  // Non-null ⇔ auto-generated postpaid monthly invoice ("2026-07" = IST month).
  billingPeriodKey               String?
  // Snapshot of the operator who raised the invoice (no FK — matches Recriauth).
  initiatedById                  String?
  initiatedByName                String?
  initiatedByEmail               String?

  razorpayPaymentId              String?   @unique
  razorpayOrderId                String?
  razorpayPaymentLinkId          String?
  razorpayPaymentLinkReferenceId String?
  paidAt                         DateTime?
  pdfS3Key                       String?
  notes                          Json?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  subject  Subject?         @relation(fields: [subjectId], references: [id])
  payments InvoicePayment[]

  @@index([userId])
  @@index([customerEmail])
  @@index([businessStatus])
  @@index([billingPeriodKey])
}

/// One recorded payment against an invoice (bank transfer, UPI, cheque, …).
/// Marking a PAYMENT_DUE invoice paid writes one of these and tops up credits.
model InvoicePayment {
  id              String               @id @default(cuid())
  invoiceId       String
  amount          Float
  method          InvoicePaymentMethod
  status          String               @default("RECORDED") // RECORDED | REFUNDED
  referenceNumber String?
  paidAt          DateTime             @default(now())
  createdAt       DateTime             @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum InvoiceKind {
  INSTANT_PAID
  PAYMENT_DUE
  POSTPAID
}

enum InvoiceBusinessStatus {
  DUE
  PAID
  VOID
}

enum InvoicePaymentMethod {
  RAZORPAY
  BANK_REMITTANCE
  BANK_TRANSFER
  CASH
  CHEQUE
  CREDIT_CARD
  UPI
}

enum InvoicePaymentTerms {
  DUE_ON_RECEIPT
  NET_15
  NET_30
  NET_45
  NET_60
  NET_90
  CUSTOM
}

model BulkBatch {
  id         String      @id @default(cuid())
  batchId    String      @unique
  userId     String
  total      Int
  done       Int         @default(0)
  failed     Int         @default(0)
  status     String      @default("processing")
  failedRows Json        @default("[]")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
}

model SubjectDraft {
  id        String   @id @default(cuid())
  subjectId String   @unique
  patch     Json
  jobId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Server-persisted draft of the client Add-Candidate form, one per user, so the
// in-progress form survives refresh / device change (auto-saved as the user
// types). Cleared once the candidate is submitted.
model CandidateFormDraft {
  id        String   @id @default(cuid())
  userId    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model OutboxEvent {
  id              String    @id @default(cuid())
  eventType       String
  payload         Json
  status          String    @default("pending")
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5)
  processAfter    DateTime  @default(now())
  processedAt     DateTime?
  lastError       String?
  idempotencyKey  String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([processAfter])
}

// =====================================================================
// Vendor Management — ported 1:1 from Recriauth (server/prisma/schema.prisma).
// Relations to Recriauth-only models (Organization, CandidateCase,
// CandidateCaseCheck, VendorVerification, User) are dropped; their scalar
// FK columns are kept so audit rows and all queries stay shape-identical.
// =====================================================================

enum VendorName {
  SUREPASS
  KONNECTNXT
  IN_HOUSE_OCR
  TELECMI
}

enum VendorCategory {
  KYC
  BGV
  TELEPHONY
  OCR
}

enum VendorStatus {
  ACTIVE
  DEGRADED
  DISABLED
  DEPRECATED
}

enum VendorBillingModel {
  PREPAID
  POSTPAID
  INTERNAL
  SUBSCRIPTION
}

enum CurrencyCode {
  USD
  EUR
  JPY
  INR
  GBP
}

enum VendorVerificationType {
  DIGILOCKER_INIT
  DIGILOCKER_STATUS
  AADHAAR_V2
  PAN_PAN
  VOTER_ID
  PASSPORT
  DRIVING_LICENSE
  AADHAAR_OCR_FRONT
  AADHAAR_OCR_BACK
  VOTER_OCR_FRONT
  VOTER_OCR_BACK
  PAN_OCR
  PASSPORT_OCR_FRONT
  PASSPORT_OCR_BACK
  DRIVING_LICENSE_OCR
  EMPLOYMENT_HISTORY
  CRIMINAL_CHECK
  CREDIT_REPORT_CHECK
  AML_CHECK
}

enum VendorCapabilityRole {
  PRIMARY
  FALLBACK
}

enum VendorCostSource {
  RATE_CARD
  VENDOR_RESPONSE
  INTERNAL
  NONE
}

model Vendor {
  id                     String             @id @default(uuid())
  code                   VendorName         @unique
  displayName            String
  category               VendorCategory
  status                 VendorStatus       @default(ACTIVE)
  billingModel           VendorBillingModel
  website                String?
  supportEmail           String?
  accountManager         String?
  slaNotes               String?
  currencyCode           CurrencyCode       @default(INR)
  lowBalanceThreshold    Decimal?           @db.Decimal(14, 2)
  requestTimeoutMs       Int?
  syncReportedBalance    Boolean            @default(true)
  subscriptionAnnualCost Decimal?           @db.Decimal(14, 2)
  subscriptionRenewalAt  DateTime?
  metadataJson           Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?

  capabilities    VendorCapability[]
  costRates       VendorCostRate[]
  balanceSnapshot VendorBalanceSnapshot?
  balanceReadings VendorBalanceReading[]

  @@index([status])
  @@index([category])
}

model VendorCostRate {
  id               String                  @id @default(uuid())
  vendorId         String
  endpointPrefix   String
  verificationType VendorVerificationType?
  unitCost         Decimal                 @db.Decimal(14, 4)
  currencyCode     CurrencyCode            @default(INR)
  effectiveFrom    DateTime                @default(now())
  effectiveTo      DateTime?
  note             String?
  createdByUserId  String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, endpointPrefix, effectiveFrom])
  @@index([vendorId, endpointPrefix, effectiveFrom])
  @@index([vendorId, verificationType])
}

model VendorBalanceSnapshot {
  id               String        @id @default(uuid())
  vendorId         String        @unique
  reportedBalance  Decimal?      @db.Decimal(14, 2)
  reportedUnit     String?
  reportedCurrency CurrencyCode?
  reportedAt       DateTime?
  source           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorBalanceReading {
  id               String        @id @default(uuid())
  vendorId         String
  reportedBalance  Decimal       @db.Decimal(14, 2)
  reportedUnit     String?
  reportedCurrency CurrencyCode?
  source           String?
  readAt           DateTime      @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, readAt])
}

model VendorCapability {
  id               String                  @id @default(uuid())
  vendorId         String
  code             String
  verificationType VendorVerificationType?
  endpointPrefix   String?
  displayName      String
  enabled          Boolean                 @default(true)
  role             VendorCapabilityRole    @default(PRIMARY)
  priority         Int                     @default(0)
  metadataJson     Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, code])
  @@index([vendorId])
  @@index([verificationType])
}

model VendorApiCallAudit {
  id                   String            @id @default(uuid())
  tenantId             String?
  candidateCaseId      String?
  candidateCaseCheckId String?
  vendorVerificationId String?
  vendor               VendorName
  endpoint             String
  httpMethod           String
  httpStatusCode       Int?
  durationMs           Int?
  requestPayload       Json
  responseBody         Json?
  success              Boolean
  errorMessage         String?
  actorUserId          String?
  ipAddress            String?
  userAgent            String?
  requestId            String?
  attemptNumber        Int?
  maxAttempts          Int?
  billable             Boolean           @default(false)
  costAmount           Decimal?          @db.Decimal(14, 2)
  costCurrency         CurrencyCode?
  costSource           VendorCostSource?
  createdAt            DateTime          @default(now())

  @@index([candidateCaseId, createdAt])
  @@index([candidateCaseCheckId, createdAt])
  @@index([vendor, endpoint, createdAt])
  @@index([vendor, success, createdAt])
  @@index([vendor, costSource])
  @@index([actorUserId, createdAt])
  @@index([vendorVerificationId])
}

/// Verification packages — the single source of truth for the bill amount.
model Package {
  id          String   @id @default(cuid())
  name        String
  priceInr    Float
  description String?
  active      Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Percentage-off discount codes applied at checkout.
model DiscountCode {
  id         String   @id @default(cuid())
  code       String   @unique
  percentOff Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
