# ── Recrify frontend — copy to .env and fill in. ──
#
# NEXT_PUBLIC_* is COMPILED INTO THE BUNDLE at build time: every value here is
# visible to anyone who loads the site, so only public-by-design values belong
# in it. Real secrets go in backend/.env (gitignored).
#
# Changing any of these needs `npm run build`, not just a restart.

# Local dev: http://localhost:3001   ·   Deployed: https://your-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Razorpay *publishable* key (rzp_test_… / rzp_live_…). The matching secret
# lives in backend/.env.
NEXT_PUBLIC_RAZORPAY_KEY=

# Same OAuth client id as the backend's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Must mirror the backend flags in backend/.env.
NEXT_PUBLIC_PASSPORT_CHECK_ENABLED=true
NEXT_PUBLIC_CREDIT_CHECK_ENABLED=false
